<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.learn.mapper.TodoMarkMapper">

    <select id="findAll" resultType="TodoMark">
        SELECT * FROM todo_mark
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_mark (name, color)
        VALUES (#{name}, #{color})
    </insert>

</mapper>
